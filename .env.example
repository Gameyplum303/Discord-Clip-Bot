# Required: bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_BOT_TOKEN=""

# Optional: register slash commands in one server instantly while testing (right-click server -> Copy Server ID)
COMMAND_GUILD_ID=""

# Optional: Whisper model used for speech recognition (tiny.en, base.en, small.en, medium.en).
# Changing it after building the Docker image downloads the new model on first start.
WHISPER_MODEL="base.en"

# Only needed for the optional Proxmox bot (docker compose --profile proxmox up)
PROXMOX_URL="pve.home.arpa"
PROXMOX_USER="root@pam"
PROXMOX_PASS=""
ADMIN_DISCORD_USER_ID=""
